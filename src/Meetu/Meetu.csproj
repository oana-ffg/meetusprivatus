<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>meetus</AssemblyName>
    <RootNamespace>Meetu</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="$(LLamaSharpVersion)" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="$(LLamaSharpVersion)" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" Version="$(LLamaSharpVersion)" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="Velopack" Version="$(VelopackVersion)" />
    <PackageReference Include="Whisper.net" Version="$(WhisperVersion)" />
    <PackageReference Include="Whisper.net.Runtime" Version="$(WhisperVersion)" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="$(WhisperVersion)" />
  </ItemGroup>
</Project>
